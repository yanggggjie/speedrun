{
  "manifest_version": 3,
  "name": "TabCobot",
  "version": "0.1.0",
  "description": "TabCobot 的 Chrome 连接扩展：常驻录制你点名的站点，并只操作它自己打开的标签页。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "TabCobot：点击可重新连接",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
