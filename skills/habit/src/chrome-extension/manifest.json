{
  "manifest_version": 3,
  "name": "habit",
  "version": "0.3.0",
  "description": "habit 的 Chrome 扩展：一个把 daemon 和页面连起来的管道。只在 habit 自己的标签组里录制和替 agent 干活，页面脚本只放进这些标签页；从不切换你的标签页、不抢前台，你自己的网页里没有 habit 的任何代码。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "habit：点击可重新连接",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms",
    "scripting",
    "storage",
    "debugger",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "135"
}
